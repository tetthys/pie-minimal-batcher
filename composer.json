{
  "name": "tetthys/pie-minimal-batcher",
  "description": "Ultra-minimal, bank-agnostic sharded batcher with RabbitMQ 4.1 and per-identity cooldown.",
  "type": "library",
  "license": "MIT",
  "version": "0.0.1",
  "require": {
    "php": "^8.2",
    "php-amqplib/php-amqplib": "^3.5"
  },
  "require-dev": {
    "pestphp/pest": "^3.0",
    "orchestra/testbench": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "Tetthys\\Pie\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tetthys\\Pie\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest -v"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
